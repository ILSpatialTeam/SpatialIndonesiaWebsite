# ── Frontend Spatial Indonesia ────────────────────────────────────────────────
#
# File ini dibaca oleh build.mjs saat merakit rilis (node build.mjs).
# Di mode pengembangan (python3 -m http.server), nilai diambil langsung dari
# <meta name="spatial-api"> di index.html — file ini tidak berpengaruh.
#
# Salin ke .env lalu isi sesuai deployment-mu.

# Alamat API backend. Kosongkan kalau API dilayani dari origin yang sama.
# Contoh: https://api-spatial.vercel.app/api/v1
SPATIAL_API=http://localhost:4000/api/v1

# Judul situs (opsional — default sudah di index.html)
# SPATIAL_TITLE=Spatial Indonesia
